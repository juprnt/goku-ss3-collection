<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.goku.cardmarket</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/Services/goku/tools/cardmarket_sync.py</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/Services/goku</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Services/goku/cardmarket.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Services/goku/cardmarket.log</string>
</dict>
</plist>
